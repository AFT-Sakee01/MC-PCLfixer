<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PCL-Download-Repair</AssemblyName>
    <Version>1.0.0.2</Version>
    <AssemblyVersion>1.0.0.2</AssemblyVersion>
    <FileVersion>1.0.0.2</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the CLR bootstrap as an embedded payload, not a .NET 10 reference. -->
    <ProjectReference Include="../bootstrap/PclRepair.Bootstrap.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" GeneratePathProperty="true" />
    <EmbeddedResource Include="../recipes/download-2.99.json" LogicalName="download-recipe.json" />
    <EmbeddedResource Include="../recipes/update-2.99.json" LogicalName="update-recipe.json" />
    <EmbeddedResource Include="../recipes/source.json" LogicalName="recipe-source.json" />
    <EmbeddedResource Include="../bootstrap/bin/$(Configuration)/net48/PCL.Repair.Bootstrap.dll" LogicalName="repair-bootstrap.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/mscorlib.dll" LogicalName="framework-mscorlib.dll" />
  </ItemGroup>
</Project>
